# Soft Steps secure API — NEVER put these in the frontend or commit real values.
PORT=8787
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Optional second origin (preview)
# FRONTEND_ORIGIN_EXTRA=http://127.0.0.1:4173

# Stripe (Dashboard → Developers → API keys). Leave empty for safe demo mode.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional Price IDs from Stripe Dashboard (Products). If omitted, Checkout uses price_data.
# STRIPE_PRICE_ONCE=price_xxx
# STRIPE_PRICE_MONTH=price_xxx

# Public success/cancel URLs (must be on FRONTEND_ORIGIN)
SUCCESS_URL=http://127.0.0.1:5173/parent/billing?checkout=success
CANCEL_URL=http://127.0.0.1:5173/parent/billing?checkout=cancel
